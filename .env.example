# Neon Postgres connection string (from your Neon project dashboard)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Vercel Blob token (Vercel dashboard -> Storage -> Blob -> create -> copy token)
BLOB_READ_WRITE_TOKEN=

# Long random string used to sign login sessions. Generate any long random text.
JWT_SECRET=

# Username/password for the very first admin account (see /lib/schema.sql notes)
ADMIN_EMAIL=you@example.com
